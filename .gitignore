*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.elf
*.axf
*.map
*.lst
*.d
*.dep
*.hex
!firmware/stm32f103-v15/release/FLASH_THIS_Z3_PB6_V15.hex
*.uvguix.*
*.uvoptx
*.mxproject
firmware/**/MDK-ARM/**/Objects/
firmware/**/MDK-ARM/**/Listings/
firmware/**/MDK-ARM/**/*.build_log.htm

# Model weights and generated inference artifacts are distributed separately
# only when their upstream licence permits it. Manifests and conversion source
# remain version-controlled.
*.onnx
*.bin
*.hbm
*.gguf
*.safetensors
*.pt
*.pth
*.ckpt
*.tflite
*.engine
models/
weights/

# Reviewed, content-bound RootScope release artifacts. Git LFS rules and
# model-assets/MANIFEST.json provide the second gate; no other weights pass.
!model-assets/vision/rootscope_answer_cards_resnet18_opset11.onnx
!model-assets/bpu/rootscope_seed17_resnet18_static_b1x3x224x224_opset11.onnx
!model-assets/bpu/rootscope_seed17_resnet18_224x224_rgb_ddr_r7_default_int16_all_nodes.bin
!model-assets/rootmind-adapter/adapter_model.safetensors

