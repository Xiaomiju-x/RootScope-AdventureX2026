# Normalize source and documentation across Windows and Linux.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
# Keil/CubeMX project inputs are text; generated firmware images are immutable
# bytes whose published SHA-256 must not be changed by line-ending conversion.
*.ioc text eol=lf
*.uvprojx text eol=lf
*.s text eol=lf
*.hex binary linguist-generated=true
# Media and reproducibility artifacts are binary.
*.jpg -text
*.jpeg -text
*.png -text
*.webp -text
*.gif -text
*.mp4 -text
*.webm -text
*.pdf binary
*.npy -text
*.npz -text
*.sqlite3 -text
# Keep repository language statistics focused on authored RootScope code.
firmware/**/Drivers/** linguist-vendored=true
firmware/**/Core/** linguist-language=C
# Preserve upstream STM32Cube/CMSIS formatting byte-for-byte; their historical
# trailing spaces are vendor content, not project-authored style failures.
firmware/stm32f103-v15/Drivers/** -whitespace
firmware/stm32f103-v15/Core/Src/system_stm32f1xx.c -whitespace
firmware/stm32f103-v15/MDK-ARM/** -whitespace
*.svg text eol=lf
# Two trailing spaces are intentional CommonMark hard breaks; keep the
# blank-at-EOF check while suppressing that Markdown-specific false positive.
*.md whitespace=-trailing-space,blank-at-eof
model-assets/**/*.onnx filter=lfs diff=lfs merge=lfs -text
model-assets/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
model-assets/**/*.bin filter=lfs diff=lfs merge=lfs -text

# These three frozen evaluation receipts are byte-bound evidence. Their
# published SHA-256 values intentionally bind the original CRLF byte streams;
# never let checkout or staging normalize their line endings.
research/rootscope_v3/evaluations/llm_pc_structured_v2_20260724.details.json -text -diff
research/rootscope_v3/evaluations/llm_pc_structured_v3_20260724.details.json -text -diff
research/rootscope_v3/evaluations/llm_pc_structured_v4_20260724.details.json -text -diff
