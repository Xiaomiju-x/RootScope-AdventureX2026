# Copy only after exact-twin qualification; this file grants no hardware authority.
ROOTSCOPE_PROJECT_ROOT=/opt/rootscope/current
ROOTSCOPE_PYTHON=/opt/rootscope/venv/bin/python3
ROOTSCOPE_CAPSULE_CONFIG=/etc/rootscope/capsule_config.json

# The optional LLM is deliberately not configured here and is never queried by
# rootscope-edge.service. install_readonly_llm.py writes a separate per-user
# rootscope-llm.env with two independent manual activation gates.
