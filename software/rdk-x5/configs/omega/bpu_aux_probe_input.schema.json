{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rootscope.omega.bpu-aux-input-manifest.v1",
  "title": "RootScope-Ω generic BPU auxiliary input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "model",
    "top_k",
    "warmup_runs",
    "images"
  ],
  "properties": {
    "schema_version": {
      "const": "rootscope.omega.bpu-aux-input-manifest.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "output_semantics"
      ],
      "properties": {
        "path": {
          "const": "/opt/hobot/model/x5/basic/mobilenetv2_224x224_nv12.bin"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_semantics": {
          "enum": [
            "LOGITS",
            "PROBABILITIES"
          ]
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "format"
      ],
      "properties": {
        "path": {
          "const": "/app/pydev_demo/01_basic_sample/imagenet1000_clsidx_to_labels.txt"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "const": "PYTHON_LITERAL_DICT_INT_TO_STRING"
        }
      }
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "warmup_runs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image_id",
          "path",
          "sha256"
        ],
        "properties": {
          "image_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
