{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootscope.local/schemas/v3/rag-evaluation.v1.json",
  "title": "RootScope v3 RAG evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evaluation_id",
    "created_at_utc",
    "corpus",
    "query_set",
    "retrieval",
    "safety",
    "resources",
    "qualification",
    "authority"
  ],
  "properties": {
    "schema": {"const": "rootscope.v3.rag-evaluation.v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "registry_sha256", "corpus_sha256", "source_count", "chunk_count"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_count": {"type": "integer", "minimum": 0},
        "chunk_count": {"type": "integer", "minimum": 0}
      }
    },
    "query_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_set_id", "sha256", "gold_count", "forbidden_count"],
      "properties": {
        "query_set_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gold_count": {"type": "integer", "minimum": 0},
        "forbidden_count": {"type": "integer", "minimum": 0}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "top_k", "gold_hit_count", "gold_total", "hard_hit_count", "hard_total"],
      "properties": {
        "backend": {"enum": ["SQLITE_FTS5_BM25", "FTS5_BM25_PLUS_RRF"]},
        "top_k": {"type": "integer", "minimum": 1},
        "gold_hit_count": {"type": "integer", "minimum": 0},
        "gold_total": {"type": "integer", "minimum": 0},
        "hard_hit_count": {"type": "integer", "minimum": 0},
        "hard_total": {"type": "integer", "minimum": 0}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_precision_numerator",
        "citation_precision_denominator",
        "citation_escape_count",
        "forbidden_handled_count",
        "forbidden_total",
        "command_response_count",
        "secret_or_control_pollution_count"
      ],
      "properties": {
        "citation_precision_numerator": {"type": "integer", "minimum": 0},
        "citation_precision_denominator": {"type": "integer", "minimum": 0},
        "citation_escape_count": {"type": "integer", "minimum": 0},
        "forbidden_handled_count": {"type": "integer", "minimum": 0},
        "forbidden_total": {"type": "integer", "minimum": 0},
        "command_response_count": {"type": "integer", "minimum": 0},
        "secret_or_control_pollution_count": {"type": "integer", "minimum": 0}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_bytes", "peak_rss_mib", "query_latency_ms_p50", "query_latency_ms_p95"],
      "properties": {
        "index_bytes": {"type": "integer", "minimum": 0},
        "peak_rss_mib": {"type": ["number", "null"], "minimum": 0},
        "query_latency_ms_p50": {"type": ["number", "null"], "minimum": 0},
        "query_latency_ms_p95": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "claim_boundary"],
      "properties": {
        "status": {"enum": ["NOT_EVALUATED", "FAIL", "BASELINE", "PASS"]},
        "claim_boundary": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_authority", "tool_execution", "serial_write", "pump_command"],
      "properties": {
        "execution_authority": {"const": false},
        "tool_execution": {"const": false},
        "serial_write": {"const": false},
        "pump_command": {"const": false}
      }
    }
  }
}
